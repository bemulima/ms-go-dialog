# Integrated Docker endpoints. Central infrastructure Compose supplies these
# variables. Replace placeholders using the existing local secret provider.
HTTP_PORT=8080
DATABASE_URL=postgres://lw_dialog:REPLACE_ME_DIALOG_DB_PASSWORD@platform-postgres:5432/lw_dialog?sslmode=disable
NATS_URL=nats://nats:4222
SERVICE_MODE=all
INTERNAL_API_TOKEN=REPLACE_ME_DIALOG_TOKEN
CLAMAV_ADDRESS=clamav:3310
FILESTORAGE_SERVICE_BASE_URL=http://filestorage:8080
FILESTORAGE_INTERNAL_TOKEN=REPLACE_ME_FILESTORAGE_DIALOG_TOKEN
USER_SERVICE_BASE_URL=http://user:8080
USER_SERVICE_INTERNAL_TOKEN=REPLACE_ME_USER_INTERNAL_TOKEN
USER_SERVICE_TIMEOUT_SECONDS=3
DIALOG_CANONICAL_STUDENT_TURN_ENABLED=false
DIALOG_TEACHER_ORDERING_V2_ENABLED=false
DIALOG_ABUSE_REPORT_ENABLED=false
